{
  "info": {
    "name": "TP 08 - Reservas de salas (HTTP + MongoDB)",
    "description": "Solicitudes de ejemplo para la API de reservas. Enviar cada solicitud de a una con \"Send\" (no usar el Runner: cada POST válido crea una reserva nueva). Cambiar la variable baseUrl si el servidor usa otro puerto. Datos ficticios, sin secretos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "idReserva",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Contrato básico",
      "item": [
        {
          "name": "GET listado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve un arreglo\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                  "console.log(\"Cantidad de reservas:\", pm.response.json().length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "description": "Listado sin filtros. Registrar la cantidad. En una base nueva, [] es válido."
          }
        },
        {
          "name": "POST crear reserva válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const reserva = pm.response.json();",
                  "pm.test(\"Tiene Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.test(\"Estado pendiente por default\", () => pm.expect(reserva.estado).to.eql(\"pendiente\"));",
                  "pm.collectionVariables.set(\"idReserva\", reserva.id);",
                  "console.log(\"Location:\", pm.response.headers.get(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"Ana Ejemplo\",\n  \"email\": \"ana@example.com\",\n  \"sala\": \"Sala Norte\",\n  \"fecha\": \"2026-10-21\",\n  \"turno\": \"Mañana\",\n  \"personas\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "description": "Pulsar Send UNA sola vez. Revisar Location en Headers de la respuesta."
          }
        },
        {
          "name": "GET reserva creada (Location)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mismo id\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idReserva\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{idReserva}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{idReserva}}"
              ]
            },
            "description": "Usa el id guardado por el POST válido. Debe devolver el mismo recurso."
          }
        },
        {
          "name": "GET ID mal formado (1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "1"
              ]
            }
          }
        },
        {
          "name": "GET ID válido inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas",
                "000000000000000000000000"
              ]
            },
            "description": "Formato válido: 404 solo si ese documento no existe."
          }
        }
      ]
    },
    {
      "name": "2. Filtro por sala",
      "item": [
        {
          "name": "GET filtro Sala Norte",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Solo Sala Norte\", () => pm.response.json().forEach((r) => pm.expect(r.sala).to.eql(\"Sala Norte\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas?sala=Sala Norte",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ],
              "query": [
                {
                  "key": "sala",
                  "value": "Sala Norte"
                }
              ]
            }
          }
        },
        {
          "name": "GET filtro sin coincidencias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Arreglo vacío\", () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas?sala=Sala Inexistente",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ],
              "query": [
                {
                  "key": "sala",
                  "value": "Sala Inexistente"
                }
              ]
            }
          }
        },
        {
          "name": "GET sala repetida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas?sala=Sala Norte&sala=Sala Sur",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ],
              "query": [
                {
                  "key": "sala",
                  "value": "Sala Norte"
                },
                {
                  "key": "sala",
                  "value": "Sala Sur"
                }
              ]
            }
          }
        }
      ]
    },
